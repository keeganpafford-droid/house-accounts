{
  "cleanUrls": true,
  "crons": [
    {
      "path": "/api/weekly-scan",
      "schedule": "0 12 * * 1"
    }
  ],
  "functions": {
    "api/weekly-scan.js": {
      "maxDuration": 300
    },
    "api/research-batch.js": {
      "maxDuration": 58
    },
    "api/queues/monitoring-consumer.js": {
      "maxDuration": 180,
      "experimentalTriggers": [
        {
          "type": "queue/v2beta",
          "topic": "monitoring-jobs",
          "retryAfterSeconds": 60,
          "initialDelaySeconds": 0
        }
      ]
    }
  }
}
